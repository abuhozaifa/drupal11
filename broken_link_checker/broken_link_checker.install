<?php
function broken_link_checker_schema() {
  return [
    'broken_links' => [
      'fields' => [
        'id' => ['type' => 'serial'],
        'nid' => ['type' => 'int'],
        'url' => ['type' => 'varchar', 'length' => 1000],
        'status_code' => ['type' => 'int'],
      ],
      'primary key' => ['id'],
    ],
  ];
}
